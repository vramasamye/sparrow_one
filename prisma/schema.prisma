generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication Models
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          UserRole  @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts       Account[]
  sessions       Session[]
  socialAccounts SocialAccount[]
  scheduledPosts ScheduledPost[]
  postHistory    UserPostHistory[]
  userTopics     UserTopic[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// Social Account Models (OAuth for Posting)
// ============================================

model SocialAccount {
  id               String         @id @default(cuid())
  userId           String
  platform         SocialPlatform
  platformUserId   String
  platformUsername String?
  accessToken      String         @db.Text // Encrypted
  refreshToken     String?        @db.Text // Encrypted
  tokenExpiresAt   DateTime?
  lastTokenRefresh DateTime?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledPosts ScheduledPost[]

  @@unique([userId, platform])
  @@map("social_accounts")
}

enum SocialPlatform {
  TWITTER
  LINKEDIN
}

// ============================================
// Topic & RSS Feed Models
// ============================================

model Topic {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  rssFeeds   RssFeed[]
  feeds      Feed[]
  userTopics UserTopic[]

  @@map("topics")
}

model UserTopic {
  id        String   @id @default(cuid())
  userId    String
  topicId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("user_topics")
}

model RssFeed {
  id              String        @id @default(cuid())
  topicId         String
  name            String
  url             String        @unique
  description     String?
  isActive        Boolean       @default(true)
  lastFetchedAt   DateTime?
  lastSuccessAt   DateTime?
  fetchErrorCount Int           @default(0)
  lastError       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Source authority and performance tracking
  authorityScore  Int           @default(10)    // 0-20, learned over time
  totalProcessed  Int           @default(0)     // Total feeds from this source
  totalApproved   Int           @default(0)     // How many got approved
  approvalRate    Float?                        // approved / total

  topic Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  feeds Feed[]

  @@map("rss_feeds")
}

model Feed {
  id              String     @id @default(cuid())
  topicId         String
  rssFeedId       String
  title           String
  url             String
  contentHash     String     @unique // SHA-256 hash for deduplication
  summary         String?    @db.Text
  content         String?    @db.Text
  imageUrl        String?
  author          String?
  publishedAt     DateTime?
  status          FeedStatus @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Scoring system
  sourceAuthorityScore Int      @default(0)      // 0-20 points
  recencyScore         Int      @default(0)      // 0-15 points
  metadataScore        Int      @default(0)      // 0-15 points
  qualityScore         Int      @default(0)      // 0-100 total

  // AI Moderation (Llama Guard)
  moderationScore      Float?                    // 0-1 confidence
  moderationCategory   String?                   // unsafe/safe/sales/spam
  moderationReasoning  String?   @db.Text

  // Flags
  isSafe               Boolean   @default(true)
  isSalesContent       Boolean   @default(false)
  hasPromoCodes        Boolean   @default(false)
  isClickbait          Boolean   @default(false)
  isTrending           Boolean   @default(false)
  autoApproved         Boolean   @default(false)
  autoRejected         Boolean   @default(false)
  scoredAt             DateTime?

  topic          Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  rssFeed        RssFeed         @relation(fields: [rssFeedId], references: [id], onDelete: Cascade)
  scheduledPosts ScheduledPost[]
  generatedPosts GeneratedPost[]

  @@index([status])
  @@index([topicId])
  @@index([createdAt])
  @@index([qualityScore])
  @@index([isSafe])
  @@index([autoApproved])
  @@index([scoredAt])
  @@map("feeds")
}

enum FeedStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

// ============================================
// Generated Posts (AI-Generated Content)
// ============================================

model GeneratedPost {
  id              String              @id @default(cuid())
  feedId          String
  twitterContent  String              @db.Text
  linkedinContent String              @db.Text
  status          GeneratedPostStatus @default(PENDING)
  generatedAt     DateTime            @default(now())
  distributedAt   DateTime?           // When posts were distributed to users
  errorMessage    String?
  retryCount      Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  feed Feed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@unique([feedId]) // One generated post per feed
  @@index([status])
  @@map("generated_posts")
}

enum GeneratedPostStatus {
  PENDING      // Queued for generation
  GENERATING   // Currently generating with GROQ
  COMPLETED    // Generated successfully
  DISTRIBUTING // Distributing to subscribers
  DISTRIBUTED  // Distributed to all subscribers
  FAILED       // Generation failed
}

// ============================================
// Scheduled Posts & Publishing
// ============================================

model ScheduledPost {
  id              String            @id @default(cuid())
  userId          String
  socialAccountId String
  feedId          String?
  platform        SocialPlatform
  content         String            @db.Text
  mediaUrls       String[]
  scheduledFor    DateTime
  status          ScheduledPostStatus @default(SCHEDULED)
  publishedAt     DateTime?
  platformPostId  String?
  errorMessage    String?
  retryCount      Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  feed          Feed?         @relation(fields: [feedId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([userId])
  @@map("scheduled_posts")
}

enum ScheduledPostStatus {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

// ============================================
// User Post History
// ============================================

model UserPostHistory {
  id             String         @id @default(cuid())
  userId         String
  platform       SocialPlatform
  platformPostId String?
  content        String         @db.Text
  mediaUrls      String[]
  publishedAt    DateTime
  engagement     Json?          // Store likes, retweets, comments, etc.
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, publishedAt])
  @@map("user_post_history")
}
